<%= render 'admin/user_syncs/loader' %>

<h6 class="text-muted mb-3">Sync</h6>

<h1>Syncs for <%= @user.name %></h1>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Filters</h5>
  </div>
  <div class="card-body">
    <%= form_with url: admin_user_syncs_path(@user), method: :get, class: 'row g-3', local: true do |f| %>
      <div class="col-md-3">
        <label for="name" class="form-label">Name</label>
        <%= f.text_field :name, value: params[:name], class: 'form-control', placeholder: 'Filter by name' %>
      </div>
      <div class="col-md-3">
        <label for="status" class="form-label">Status</label>
        <%= f.select :status, 
                    options_for_select([['All', ''], ['Disabled', 'disabled'], ['Healthy', 'healthy'], 
                                       ['Pending', 'pending'], ['Failed', 'failed'], ['Aborted', 'aborted']], 
                                       selected: params[:status]), 
                    {}, class: 'form-select' %>
      </div>
      <div class="col-md-2">
        <label for="sort" class="form-label">Sort By</label>
        <%= f.select :sort, 
                    options_for_select([['Created At', 'created_at'], ['Updated At', 'updated_at']], 
                                       selected: params[:sort] || 'created_at'), 
                    {}, class: 'form-select' %>
      </div>
      <div class="col-md-2">
        <label for="direction" class="form-label">Direction</label>
        <%= f.select :direction, 
                    options_for_select([['Descending', 'desc'], ['Ascending', 'asc']], 
                                       selected: params[:direction] || 'desc'), 
                    {}, class: 'form-select' %>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <%= f.submit 'Apply Filters', class: 'btn btn-primary me-2' %>
        <%= link_to 'Clear Filters', admin_user_syncs_path(@user), class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h5 class="mb-0">Syncs</h5>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Source</th>
            <th>Destination</th>
            <th>Status</th>
            <th>Schedule Type</th>
            <th>Created At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @syncs.any? %>
            <% @syncs.each do |sync| %>
              <tr>
                <td><%= sync.id %></td>
                <td><%= sync.name %></td>
                <td><%= sync.source.name rescue 'N/A' %></td>
                <td><%= sync.destination.name rescue 'N/A' %></td>
                <td>
                  <span class="badge bg-<%= sync_status_color(sync.status) %>">
                    <%= sync.status.titleize %>
                  </span>
                </td>
                <td><%= sync.schedule_type.titleize %></td>
                <td><%= sync.created_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
                <td>
                  <%= link_to 'View Runs', admin_user_sync_path(@user, sync), class: 'btn btn-sm btn-primary' %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="text-center">No syncs found</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer">
    <%= paginate @syncs %>
  </div>
</div>

<div class="mt-3">
  <%= link_to 'Back to User', admin_user_path(@user), class: 'btn btn-secondary' %>
</div>
