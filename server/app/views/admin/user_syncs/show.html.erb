<%= render 'admin/user_syncs/loader' %>

<h6 class="text-muted mb-3">Sync > Sync Run</h6>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Users", admin_users_path %></li>
    <li class="breadcrumb-item"><%= link_to @user.name, admin_user_path(@user) %></li>
    <li class="breadcrumb-item"><%= link_to "Syncs", admin_user_syncs_path(@user) %></li>
    <li class="breadcrumb-item active" aria-current="page">Sync #<%= @sync.id %></li>
  </ol>
</nav>

<h1>Sync Runs for <%= @sync.stream_name %></h1>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Sync Details</h5>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <p><strong>ID:</strong> <%= @sync.id %></p>
        <p><strong>Stream Name:</strong> <%= @sync.stream_name %></p>
        <p><strong>Status:</strong> 
          <span class="badge bg-<%= sync_status_color(@sync.status) %>">
            <%= @sync.status.titleize %>
          </span>
        </p>
        <p><strong>Schedule Type:</strong> <%= @sync.schedule_type.titleize %></p>
      </div>
      <div class="col-md-6">
        <p><strong>Source:</strong> <%= @sync.source.name rescue 'N/A' %></p>
        <p><strong>Destination:</strong> <%= @sync.destination.name rescue 'N/A' %></p>
        <p><strong>Created At:</strong> <%= @sync.created_at.strftime('%Y-%m-%d %H:%M:%S') %></p>
        <p><strong>Updated At:</strong> <%= @sync.updated_at.strftime('%Y-%m-%d %H:%M:%S') %></p>
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Filters</h5>
  </div>
  <div class="card-body">
    <%= form_with url: admin_user_sync_path(@user, @sync), method: :get, class: 'row g-3', local: true do |f| %>
      <div class="col-md-3">
        <label for="status" class="form-label">Status</label>
        <%= f.select :status, 
                    options_for_select([['All', ''], ['Pending', 'pending'], ['Started', 'started'], 
                                       ['Querying', 'querying'], ['Queued', 'queued'], ['In Progress', 'in_progress'],
                                       ['Success', 'success'], ['Paused', 'paused'], ['Failed', 'failed'], ['Canceled', 'canceled']], 
                                       selected: params[:status]), 
                    {}, class: 'form-select' %>
      </div>
      <div class="col-md-3">
        <label for="sort" class="form-label">Sort By</label>
        <%= f.select :sort, 
                    options_for_select([['Created At', 'created_at'], ['Updated At', 'updated_at'], 
                                       ['Total Rows', 'total_rows'], ['Successful Rows', 'successful_rows']], 
                                       selected: params[:sort] || 'created_at'), 
                    {}, class: 'form-select' %>
      </div>
      <div class="col-md-3">
        <label for="direction" class="form-label">Direction</label>
        <%= f.select :direction, 
                    options_for_select([['Descending', 'desc'], ['Ascending', 'asc']], 
                                       selected: params[:direction] || 'desc'), 
                    {}, class: 'form-select' %>
      </div>
      <div class="col-md-3 d-flex align-items-end">
        <%= f.submit 'Apply Filters', class: 'btn btn-primary me-2' %>
        <%= link_to 'Clear Filters', admin_user_sync_path(@user, @sync), class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Status Sequence</h5>
  </div>
  <div class="card-body">
    <div class="status-sequence">
      <div class="d-flex justify-content-between align-items-center">
        <% @status_sequence&.each_with_index do |status, index| %>
          <% 
            # Safe comparison with nil check
            is_before_current = @current_status_index && index < @current_status_index
            is_current = @current_status_index && index == @current_status_index
          %>
          <div class="status-item text-center">
            <div class="status-circle <%= is_before_current ? 'bg-success' : (is_current ? 'bg-primary' : 'bg-warning') %>"></div>
            <div class="status-label">
              <% if is_current %>
                <span class="current-label">Current</span>
              <% end %>
              <%= status.titleize %>
            </div>
          </div>
          
          <% if index < @status_sequence.length - 1 %>
            <div class="status-line <%= is_before_current ? 'bg-success' : 'bg-warning' %>"></div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h5 class="mb-0">Sync Runs</h5>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>ID</th>
            <th>Status</th>
            <th>Total Rows</th>
            <th>Successful Rows</th>
            <th>Failed Rows</th>
            <th>Started At</th>
            <th>Finished At</th>
            <th>Duration</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if @sync_runs.any? %>
            <% @sync_runs.each do |sync_run| %>
              <tr>
                <td><%= sync_run.id %></td>
                <td>
                  <span class="badge bg-<%= sync_run_status_color(sync_run.status) %>">
                    <%= sync_run.status.titleize %>
                  </span>
                </td>
                <td><%= sync_run.total_rows %></td>
                <td><%= sync_run.successful_rows %></td>
                <td><%= sync_run.failed_rows %></td>
                <td><%= sync_run.started_at&.strftime('%Y-%m-%d %H:%M:%S') || 'N/A' %></td>
                <td><%= sync_run.finished_at&.strftime('%Y-%m-%d %H:%M:%S') || 'N/A' %></td>
                <td><%= sync_run.started_at && sync_run.finished_at ? distance_of_time_in_words(sync_run.started_at, sync_run.finished_at) : 'N/A' %></td>
                <td>
                  <%= link_to 'View Records', records_admin_user_sync_path(@user, @sync, sync_run_id: sync_run.id), class: 'btn btn-sm btn-primary' %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="9" class="text-center">No sync runs found</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer">
    <%= paginate @sync_runs %>
  </div>
</div>

<div class="mt-3">
  <%= link_to 'Back to Syncs', admin_user_syncs_path(@user), class: 'btn btn-secondary' %>
</div>

<style>
  .status-sequence {
    margin: 20px 0;
  }
  .status-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .status-circle {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    margin-bottom: 5px;
  }
  .status-line {
    flex-grow: 1;
    height: 3px;
    margin-top: 10px;
  }
  .status-label {
    font-size: 12px;
    text-align: center;
    max-width: 80px;
  }
  .current-label {
    display: block;
    font-weight: bold;
    color: #007bff;
    font-size: 11px;
    margin-bottom: 3px;
  }
</style>
