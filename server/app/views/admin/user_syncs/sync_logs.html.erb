<%= render 'admin/user_syncs/loader' %>

<h6 class="text-muted mb-3">Sync > Sync Run > Sync Run Logs</h6>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Users", admin_users_path %></li>
    <li class="breadcrumb-item"><%= link_to @user.name, admin_user_path(@user) %></li>
    <li class="breadcrumb-item"><%= link_to "Syncs", admin_user_syncs_path(@user) %></li>
    <li class="breadcrumb-item"><%= link_to "Sync ##{@sync.id}", admin_user_sync_path(@user, @sync) %></li>
    <li class="breadcrumb-item active" aria-current="page">Sync Run #<%= @sync_run.id %> Logs</li>
  </ol>
</nav>

<h1>Sync Logs for Run #<%= @sync_run.id %></h1>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Sync Run Details</h5>
  </div>
  <div class="card-body">
    <div class="row">
      <div class="col-md-6">
        <p><strong>ID:</strong> <%= @sync_run.id %></p>
        <p><strong>Status:</strong> 
          <span class="badge bg-<%= sync_run_status_color(@sync_run.status) %>">
            <%= @sync_run.status.titleize %>
          </span>
        </p>
        <p><strong>Total Rows:</strong> <%= @sync_run.total_rows %></p>
        <p><strong>Successful Rows:</strong> <%= @sync_run.successful_rows %></p>
        <p><strong>Failed Rows:</strong> <%= @sync_run.failed_rows %></p>
      </div>
      <div class="col-md-6">
        <p><strong>Started At:</strong> <%= @sync_run.started_at&.strftime('%Y-%m-%d %H:%M:%S') || 'N/A' %></p>
        <p><strong>Finished At:</strong> <%= @sync_run.finished_at&.strftime('%Y-%m-%d %H:%M:%S') || 'N/A' %></p>
        <p><strong>Duration:</strong> <%= @sync_run.started_at && @sync_run.finished_at ? distance_of_time_in_words(@sync_run.started_at, @sync_run.finished_at) : 'N/A' %></p>
        <p><strong>Sync Run Type:</strong> <%= @sync_run.sync_run_type.titleize %></p>
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-header">
    <h5 class="mb-0">Filters</h5>
  </div>
  <div class="card-body">
    <%= form_with url: logs_admin_user_sync_path(@user, @sync, sync_run_id: @sync_run.id), method: :get, class: 'row g-3', local: true do |f| %>
        <div class="col-md-3">
        <label for="log_message" class="form-label">Log Message</label>
        <%= f.text_field :log_message, value: params[:log_message], class: 'form-control', placeholder: 'Filter by log message' %>
        </div>
        <div class="col-md-3">
        <label for="sort" class="form-label">Sort By</label>
        <%= f.select :sort, 
                    options_for_select([
                      ['Created At', 'created_at']
                    ], selected: 'created_at'), 
                    {}, class: 'form-select' %>
      </div>
      <div class="col-md-3">
        <label for="direction" class="form-label">Direction</label>
        <%= f.select :direction, 
                    options_for_select([['Ascending', 'asc'], ['Descending', 'desc']], 
                                       selected: params[:direction] || 'asc'), 
                    {}, class: 'form-select' %>
      </div>
      <div class="col-md-6 d-flex align-items-end">
        <%= f.submit 'Apply Filters', class: 'btn btn-primary me-2' %>
        <%= link_to 'Clear', logs_admin_user_sync_path(@user, @sync, sync_run_id: @sync_run.id), class: 'btn btn-outline-secondary' %>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Worker Logs</h5>
    <span class="badge bg-primary"><%= @total_logs_count %> Logs Total</span>
  </div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-striped table-hover">
        <thead>
          <tr>
            <th>ID</th>
            <th>Log Message</th>
            <th>Created At</th>
          </tr>
        </thead>
        <tbody>
          <% if @sync_logs.any? %>
            <% @sync_logs.each do |log| %>
              <tr>
                <td><%= log.id %></td>
                <td>
                  <% if log.log_message.present? %>
                    <% if log.log_message.length > 100 %>
                      <div>
                        <span id="log-preview-<%= log.id %>"><%= truncate(log.log_message, length: 100) %></span>
                        <button class="btn btn-sm btn-outline-secondary ms-2" type="button" data-bs-toggle="collapse" data-bs-target="#log-full-<%= log.id %>" aria-expanded="false">
                          View Full
                        </button>
                      </div>
                      <div class="collapse mt-2" id="log-full-<%= log.id %>">
                        <div class="card card-body">
                          <pre class="mb-0"><%= log.log_message %></pre>
                        </div>
                      </div>
                    <% else %>
                      <pre class="mb-0"><%= log.log_message %></pre>
                    <% end %>
                  <% else %>
                    <span class="text-muted">No message</span>
                  <% end %>
                </td>
                <td><%= log.created_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="4" class="text-center">No worker logs found</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="card-footer">
    <%= paginate @sync_logs %>
  </div>
</div>

<div class="mt-3">
  <%= link_to 'Back to Sync Records', records_admin_user_sync_path(@user, @sync, sync_run_id: @sync_run.id), class: 'btn btn-secondary me-2' %>
  <%= link_to 'Back to Sync Runs', admin_user_sync_path(@user, @sync), class: 'btn btn-outline-secondary' %>
</div>
